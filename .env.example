# 값은 .env.local(저장소에 올라가지 않음)과 Vercel 환경변수에만 넣습니다.
# 쏘웰라(app.ssolwellnesshouse.com)·디저트·타로 테스트와 "같은" Supabase 프로젝트 값을 씁니다(같은 계정으로 로그인).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(절대 NEXT_PUBLIC_ 붙이지 않기). rel_sessions 저장·로그인 확인에 씁니다.
SUPABASE_SERVICE_ROLE_KEY=
# AI 리포트(결과 5~9쪽). 비어 있으면 리포트를 만들지 않고 '쓰는 중'으로 남습니다.
OPENAI_API_KEY=
# 선택: 리포트 모델(기본 gpt-5.6-luna — 쏘웰라·타로와 같음)
# REL_AI_MODEL=
# 선택: 사이트 주소(기본 https://couple.ssolwellnesshouse.com)
# NEXT_PUBLIC_SITE_URL=
# 카카오톡 카드 공유(공개돼도 되는 JavaScript 키 — 타로·아스트로와 같은 카카오 앱 키를 써도 됨).
# 카카오 개발자센터에서 이 앱의 [JavaScript SDK 도메인]과 [제품 링크 관리 → 웹 도메인]에 https://couple.ssolwellnesshouse.com 등록 필요.
# 비어 있으면 휴대폰 공유창·링크 복사로 공유합니다. NEXT_PUBLIC_ 값이라 넣은 뒤 다시 배포해야 반영됩니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
